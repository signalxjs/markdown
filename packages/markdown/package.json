{
    "name": "@sigx/markdown",
    "version": "0.1.0",
    "description": "Markdown for SignalX — an mdast-compatible incremental parser that keeps finalized blocks stable while text streams in, a serializer, a renderer-neutral engine with a DOM view, and a block-tree editor",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "development": "./dist/testing.js",
            "production": "./dist/testing.prod.js",
            "import": "./dist/testing.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "signalx",
        "markdown",
        "mdast",
        "commonmark",
        "gfm",
        "streaming",
        "editor"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/markdown.git",
        "directory": "packages/markdown"
    },
    "homepage": "https://sigx.dev/markdown/",
    "bugs": {
        "url": "https://github.com/signalxjs/markdown/issues"
    },
    "devDependencies": {
        "@sigx/reactivity": "catalog:",
        "@sigx/runtime-core": "catalog:",
        "@sigx/runtime-dom": "catalog:",
        "@sigx/server-renderer": "catalog:",
        "@sigx/vite": "catalog:",
        "@types/node": "^25.9.1",
        "sigx": "catalog:",
        "typescript": "^6.0.3",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@sigx/reactivity": "^0.15.0",
        "@sigx/runtime-core": "^0.15.0"
    }
}
